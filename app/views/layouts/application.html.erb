<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Helloworldapplication" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Bootstrap CSS CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    >
    <!-- Bootstrap Icon -->
    <link 
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
      rel="stylesheet" 
    >

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <!-- HOMEPAGE -->
    <% if current_page?(root_path) || current_page?(about_path) %>
      <div>
        <%= yield %>
      </div>
    <% else %>

    <!-- SCHOOL MANAGER -->
    <div id="school-manager" class="d-flex">
      <!-- Navbar -->
      <nav class="d-flex flex-column ps-3 py-3 text-white sidebar">
        <a class="d-flex flex-column justify-content-center align-items-center mt-3 text-white text-decoration-none" href="/">
          <svg width="80px" height="80px" viewBox="-1.5 -1.5 18.00 18.00" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#FFFFFF" stroke-width="1">
            <path d="M7.5 4.5L11.5 6.5V14.5H3.5V6.5L7.5 4.5ZM7.5 4.5V0M0 14.5H15M1.5 14.5V8.5H3.5M13.5 14.5V8.5H11.5M6.5 14.5V11.5H8.5V14.5M7.5 0.5H10.5V2.5H7.5M7.5 9.5C6.94772 9.5 6.5 9.05228 6.5 8.5C6.5 7.94772 6.94772 7.5 7.5 7.5C8.05228 7.5 8.5 7.94772 8.5 8.5C8.5 9.05228 8.05228 9.5 7.5 9.5Z" stroke="#FFFFFF"></path> 
          </svg>
          <strong class="m-0">School Manager</strong>
        </a>

        <hr class="text-white opacity-50">

        <ul class="nav nav-pills nav-fill flex-column">
          <li class="nav-item school-manager-nav">
            <%= link_to students_path, class: "nav-link #{'active' if controller_name == 'students'}" do %>
              <%= inline_svg "icons/student.svg" %>
              <span>Students</span>
            <%end%>
          </li>
          <li class="nav-item school-manager-nav">
            <%= link_to teachers_path, class: "nav-link #{'active' if controller_name == 'teachers'}" do %>
              <%= inline_svg "icons/teacher.svg" %>
              <span>Teachers</span>
            <% end %>
          </li>
          <li class="nav-item school-manager-nav">
            <%= link_to sections_path, class: "nav-link #{'active' if controller_name == 'sections'}" do %>
              <%= inline_svg "icons/section.svg" %>
              <span>Sections</span>
            <% end %>
          </li>
          <li class="nav-item school-manager-nav">
            <%= link_to subjects_path, class: "nav-link #{'active' if controller_name == 'subjects'}" do %>
              <%= inline_svg "icons/subject.svg" %>
              <span>Subjects</span>
            <% end %>
          </li>
          <li class="nav-item school-manager-nav">
            <%= link_to departments_path, class: "nav-link #{'active' if controller_name == 'departments'}" do %>
              <%= inline_svg "icons/department.svg" %>
              <span>Departments</span>
            <% end %>
          </li>
          <li class="nav-item school-manager-nav">
            <%= link_to staffs_path, class: "nav-link #{'active' if controller_name == 'staffs'}" do %>
              <%= inline_svg "icons/staff.svg" %>
              <span>Staffs</span>
            <% end %>
          </li>
          <li class="nav-item school-manager-nav">
            <%= link_to guardians_path, class: "nav-link #{'active' if controller_name == 'guardians'}" do %>
              <%= inline_svg "icons/guardian.svg" %>
              <span>Guardians</span>
            <% end %>
          </li>
        </ul>

        <div class="logout-container mt-auto">
          <hr class="text-white opacity-50">
          <%= link_to '/', id: "logout-btn", class: "nav-link logout-btn" do %>
            <%= inline_svg "icons/logout.svg" %>
            <span>Logout</span>
          <% end %>
        </div>

      </nav>

      <!-- Main Content -->
      <div class="flex-grow-1 d-flex flex-column vh-100 p-4 overflow-hidden">
        <% flash.each do |key, message| %>
          <div class="alert alert-<%= key == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <div class="flex-grow-1 d-flex flex-column bg-light p-4 rounded-4 overflow-hidden">
          <%= yield %>
        </div>
      </div>
      <% end %>
    </div>

    <!-- Bootstrap JS CDN (Optional for dropdowns, nav, etc.) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>
  </body>
</html>

