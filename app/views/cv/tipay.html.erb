<div id="cv-page" class="cv-bg">

  <div class="parallax-shape shape-a"></div>
  <div class="parallax-shape shape-b"></div>
  <div class="parallax-shape shape-c"></div>
  <div class="parallax-shape shape-d"></div>
  <div class="parallax-shape shape-e"></div>
  <div class="parallax-shape shape-f"></div>
  <div class="parallax-shape shape-g"></div>

  <%= render "home/navbar" %>

  <div class="container cv-container mt-4">
    <div class="row justify-content-center w-100">
      <div class="col-lg-10 col-xl-9 position-relative">

      <%= link_to about_path, class: "back-btn-floating" do %>
        <i class="bi bi-arrow-left"></i> 
        <span>Back to About</span>
      <% end %>

        <div class="card cv-card shadow-lg overflow-hidden border-0 rounded-4">
          
          <div class="cv-header p-4 p-md-5 bg-white border-bottom"> 
            <div class="row align-items-center">
              <div class="col-md-3 text-center mb-3 mb-md-0">
                <div class="profile-img-container mx-auto">
                  <%= image_tag "tipay-portrait.JPG" , alt: "Gian Tipay", class:"profile-picture" %>
                </div>
              </div>
              <div class="col-md-9 text-center text-md-start">
                <h1 class="display-5 fw-bold mb-1 text-primary">Manuel Gian A. Tipay</h1>
                <p class="lead text-muted mb-3 fw-medium">Frontend Developer | Computer Engineering Student</p>
                
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-start text-muted">
                  <a href="mailto:mtipay@gbox.adnu.edu.ph" class="text-muted text-decoration-none hover-primary">
                    <i class="bi bi-envelope-fill me-1 text-secondary"></i> mtipay@gbox.adnu.edu.ph
                  </a>
                  <a href="https://github.com/mtipay-stack" target="_blank" class="text-muted text-decoration-none hover-primary">
                    <i class="bi bi-github me-1 text-secondary"></i> mtipay-stack
                  </a>
                  <a href="#" target="_blank" class="text-muted text-decoration-none hover-primary">
                    <i class="bi bi-linkedin me-1 text-secondary"></i> LinkedIn       
                  </a>
                  <span class="text-muted">
                    <i class="bi bi-geo-alt-fill me-1 text-secondary"></i> Naga City, Philippines
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="card-body p-4 p-md-5 bg-white">
            
            <!-- PROFESSIONAL SUMMARY -->
            <section class="mb-5">
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-person-lines-fill fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Professional Summary</h2>
              </div>
              <p class="text-muted">
                A dedicated and detail-oriented <strong>Frontend Developer</strong> with strong focus on building clean, responsive, and user-friendly interfaces. <strong>Skilled in HTML, CSS, JavaScript</strong>, and modern <strong>UI</strong> frameworks, I enjoy transforming ideas into polished digital experiences. Currently studying Computer Engineering, I continuously explore new tools and design practices to improve my development workflow. Motivated to contribute to real-world projects while growing in a collaborative environment.
              </p>
            </section>

            <!-- TECHNICAL SKILLS -->
            <section class="mb-5">
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-cpu-fill fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Technical Skills</h2>
              </div>
              
              <div class="mb-3">
                <small class="text-uppercase text-muted fw-bold ls-1">Core Stack</small>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <span class="badge rounded-pill text-bg-primary py-2 px-3"><i class="bi bi-bootstrap-fill me-1"></i> Bootstrap 5</span>
                  <span class="badge rounded-pill text-bg-warning py-2 px-3 text-dark"><i class="bi bi-filetype-js me-1"></i> JavaScript (ES6+)</span>
                  <span class="badge rounded-pill text-bg-info py-2 px-3 text-white"><i class="bi bi-filetype-jsx me-1"></i> React</span>
                  <span class="badge rounded-pill text-bg-danger py-2 px-3"><i class="bi bi-git me-1"></i> Git & GitHub</span>
                </div>
              </div>

              <div>
                <small class="text-uppercase text-muted fw-bold ls-1">Programming Languages</small>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <span class="badge rounded-pill border border-secondary text-secondary py-2 px-3"><i class="bi bi-filetype-html me-1"></i> HTML5</span>
                  <span class="badge rounded-pill border border-secondary text-secondary py-2 px-3"><i class="bi bi-filetype-css me-1"></i> CSS3</span>
                  <span class="badge rounded-pill border border-secondary text-secondary py-2 px-3"><i class="bi bi-filetype-js me-1"></i> JavaScript</span>
                </div>
              </div>
            </section>

            <!-- EXPERIENCE -->
            <section class="mb-5">
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-briefcase-fill fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Experience</h2>
              </div>
              
              <div class="accordion" id="experienceAccordion">

                <div class="accordion-item cv-accordion-item mb-3">
                  <h3 class="accordion-header" id="expHeadingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#expCollapseOne" aria-expanded="true" aria-controls="expCollapseOne">
                      <div class="d-flex flex-column flex-md-row justify-content-between w-100 pe-3">
                        <span class="fw-bold">Frontend Developer — Personal Portfolio Website</span>
                        <span class="small text-muted fw-normal">Self-Directed | Present</span>
                      </div>
                    </button>
                  </h3>
                  <div id="expCollapseOne" class="accordion-collapse collapse show" aria-labelledby="expHeadingOne" data-bs-parent="#experienceAccordion">
                    <div class="accordion-body">
                      <p class="mb-2"><em>Designed and developed a modern personal website to showcase my web development projects.</em></p>
                      <ul class="list-unstyled mt-3">
                        <li class="mb-2 d-flex"><i class="bi bi-check2-square text-primary me-2 mt-1"></i>
                          <span>Implemented a fully responsive UI using <strong>Bootstrap 5</strong> and custom CSS.</span>
                        </li>
                        <li class="mb-2 d-flex"><i class="bi bi-check2-square text-primary me-2 mt-1"></i>
                          <span>Enhanced user interaction with <strong>JavaScript</strong> events, animations, and dynamic components.</span>
                        </li>
                        <li class="mb-2 d-flex"><i class="bi bi-check2-square text-primary me-2 mt-1"></i>
                          <span>Used <strong>Git & GitHub</strong> for version control, deployment, and project management.</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>

              </div>
            </section>

            <!-- PROJECTS -->
            <section class="mb-5">
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-code-square fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Notable Projects</h2>
              </div>
              
              <div class="row g-4">
                <div class="col-md-6">
                  <div class="p-3 border rounded-3 h-100 bg-light">
                    <h5 class="fw-bold text-dark">
                      <i class="bi bi-window-sidebar me-2 text-primary"></i>
                      Responsive Landing Page
                    </h5>
                    <p class="small text-muted mb-2">HTML, CSS, JavaScript</p>
                    <p class="small">
                      Built a clean and modern landing page optimized for all screen sizes. Implemented animations, smooth scrolling, and reusable UI components to ensure an engaging user experience.
                    </p>
                  </div>
                </div>

                <div class="col-md-6">
                  <div class="p-3 border rounded-3 h-100 bg-light">
                    <h5 class="fw-bold text-dark">
                      <i class="bi bi-app-indicator me-2 text-primary"></i>
                      React Task Manager App
                    </h5>
                    <p class="small text-muted mb-2">React & LocalStorage</p>
                    <p class="small">
                      Developed a task management web app with interactive UI, state management using React Hooks, and local data persistence through LocalStorage.
                    </p>
                  </div>
                </div>
              </div>
            </section>

            <!-- EDUCATION -->
            <section class="mb-4">
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-mortarboard-fill fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Education</h2>
              </div>
              
              <div class="list-group list-group-flush">
                <div class="list-group-item px-0 border-0">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <h5 class="mb-1 fw-bold">B.S. Computer Engineering</h5>
                      <p class="mb-0 text-muted">Ateneo de Naga University</p>
                      <small class="text-primary">Expected Graduation 2026</small>
                    </div>
                    <span class="badge bg-light text-dark border">Current</span>
                  </div>
                </div>

                <div class="list-group-item px-0 border-0 mt-3">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <h5 class="mb-1 fw-bold">Senior High School (STEM)</h5>
                      <p class="mb-0 text-muted">Ateneo de Naga University</p>
                    </div>
                    <span class="badge bg-light text-dark border">2021 - 2023</span>
                  </div>
                </div>
              </div>
            </section>

            <!-- CERTIFICATIONS -->
            <section>
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-award-fill fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Certifications</h2>
              </div>
              <ul class="list-inline">
                <li class="list-inline-item">
                  <span class="badge border border-primary text-primary bg-white p-2">
                    <i class="bi bi-patch-check-fill me-1"></i> FreeCodeCamp: Responsive Web Design
                  </span>
                </li>
                <li class="list-inline-item">
                  <span class="badge border border-primary text-primary bg-white p-2">
                    <i class="bi bi-patch-check-fill me-1"></i> JavaScript Algorithms & Data Structures
                  </span>
                </li>
                <li class="list-inline-item">
                  <span class="badge border border-primary text-primary bg-white p-2">
                    <i class="bi bi-patch-check-fill me-1"></i> Meta Front-End Developer (Coursera)
                  </span>
                </li>
              </ul>
            </section>

          </div>
        </div>
        
        <div class="text-center text-white-50 mt-4 pb-5">
          <small>&copy; <%= Time.current.year %> Manuel Gian A. Tipay. Built with Rails 7 & Bootstrap 5.</small>
          <br>
          <small>NOT REAL INFORMATION</small>
        </div>

      </div>
    </div>
  </div>
</div>

<%= render "home/footer" %>
