<div id="cv-background" class="cv-bg">

  <div class="parallax-shape shape-a"></div>
  <div class="parallax-shape shape-b"></div>
  <div class="parallax-shape shape-c"></div>
  <div class="parallax-shape shape-d"></div>
  <div class="parallax-shape shape-e"></div>
  <div class="parallax-shape shape-f"></div>
  <div class="parallax-shape shape-g"></div>

  <%= render "home/navbar" %>
  
  <div class="container cv-container">
    <div class="row justify-content-center w-100">
      <div class="col-lg-10 col-xl-8">
        <div class="card cv-card shadow-lg cv-animated-content">

          <header class="mb-5">
            <div class="row align-items-center">
              
              <div class="col-md-3 text-center text-md-start mb-3 mb-md-0">
                <%= image_tag "santiago-portrait.JPG", class: "profile-picture shadow-sm", alt: "Matt Santiago Picture" %>
              </div>
              
              <div class="col-md-9 text-center text-md-start">
                <h1 class="display-5 fw-bold mb-0">Matt Rayner P. Santiago</h1>
                <p class="lead text-muted mb-3">Backend Developer</p>
                
                <div class="d-flex flex-column gap-1 justify-content-md-start">
                  <a href="mailto:mrsantiago@gbox.adnu.edu.ph" target="_blank" rel="noopener" class="cv-link">
                    <i class="bi bi-envelope-fill me-2"></i>mrsantiago@gbox.adnu.edu.ph
                  </a>
                  <a href="https://github.com/MaTT-R4Yn0" target="_blank" rel="noopener" class="cv-link">
                    <i class="bi bi-github me-2"></i>GitHub
                  </a>
                  <a href="https://linkedin.com/in/matt-rayner-p-santiago-1b8596296" target="_blank" rel="noopener" class="cv-link">
                    <i class="bi bi-linkedin me-2"></i>LinkedIn
                  </a>
                </div>
              </div>
            </div>
          </header>

          <section class="mb-5">
            <h2 class="h4 mb-3 text-secondary border-bottom pb-2">Summary</h2>
            <p>
              Dedicated Backend Developer and Computer Engineering student with a focus on building robust, 
              scalable web applications using Ruby on Rails. Passionate about bridging 
              hardware-software interfaces and optimizing logic-heavy backend architectures. Currently 
              applying engineering principles to web development to create clean, maintainable code 
              and efficient database structures.
            </p>
          </section>

          <section class="mb-5">
            <h2 class="h4 mb-3 text-secondary border-bottom pb-2">Skills</h2>
            <div class="d-flex flex-wrap gap-4"> 
              <span class="badge skill-badge-hero">Ruby on Rails</span>
              <span class="badge skill-badge-hero">SQL</span>
              <span class="badge skill-badge-hero">Bootstrap 5</span>
              <span class="badge skill-badge-hero">Git</span>
            </div>
          </section>

          <section class="mb-5">
            <h2 class="h4 mb-3 text-secondary border-bottom pb-2">Experience</h2>
            <div class="accordion custom-accordion" id="experienceAccordion">

              <div class="accordion-item cv-accordion-item">
                <h3 class="accordion-header" id="expHeadingOne">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#expCollapseOne" aria-expanded="false" aria-controls="expCollapseOne">
                    <strong>Developer - School Manager</strong>
                  </button>
                </h3>
                <div id="expCollapseOne" class="accordion-collapse collapse" aria-labelledby="expHeadingOne" data-bs-parent="#experienceAccordion">
                  <div class="accordion-body">
                    <p class="text-muted"><em>Details:</em></p>
                    <ul class="list-unstyled">
                      <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Implemented a database schema to handle students, faculty, and course enrollments.</li>
                      <li><i class="bi bi-check-circle-fill text-success me-2"></i> Integrated a responsive user interface using Bootstrap 5 to facilitate ease of use.</li>
                    </ul>
                  </div>
                </div>
              </div>

            </div>
          </section>

          <section>
            <h2 class="h4 mb-3 text-secondary border-bottom pb-2">Education</h2>
            <div class="accordion custom-accordion" id="educationAccordion">

              <div class="accordion-item cv-accordion-item">
                <h3 class="accordion-header" id="eduHeadingOne">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#eduCollapseOne" aria-expanded="false" aria-controls="eduCollapseOne">
                    <strong>Bachelor of Science in Computer Engineering</strong>
                  </button>
                </h3>
                <div id="eduCollapseOne" class="accordion-collapse collapse" aria-labelledby="eduHeadingOne" data-bs-parent="#educationAccordion">
                  <div class="accordion-body">
                    <p class="mb-1">Ateneo de Naga University</p>
                    <p class="small text-muted mb-0">(2023 - Present)</p>
                  </div>
                </div>
              </div>
              
              <div class="accordion-item cv-accordion-item">
                <h3 class="accordion-header" id="eduHeadingTwo">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#eduCollapseTwo" aria-expanded="false" aria-controls="eduCollapseTwo">
                    <strong>Senior High School - STEM</strong>
                  </button>
                </h3>
                <div id="eduCollapseTwo" class="accordion-collapse collapse" aria-labelledby="eduHeadingTwo" data-bs-parent="#educationAccordion">
                  <div class="accordion-body">
                    <p class="mb-1">Ateneo de Naga University</p>
                    <p class="small text-muted mb-0">(2021 - 2023)</p>
                  </div>
                </div>
              </div>
              
            </div>
          </section>

        </div>
      </div>
    </div>
  </div>
</div>