<div id="cv-page" class="cv-bg">

  <div class="parallax-shape shape-a"></div>
  <div class="parallax-shape shape-b"></div>
  <div class="parallax-shape shape-c"></div>
  <div class="parallax-shape shape-d"></div>
  <div class="parallax-shape shape-e"></div>
  <div class="parallax-shape shape-f"></div>
  <div class="parallax-shape shape-g"></div>

  <%= render "home/navbar" %>
  
  <div class="container cv-container mt-4">
    <div class="row justify-content-center w-100">
      <div class="col-lg-10 col-xl-9">
        
        <div class="card cv-card shadow-lg overflow-hidden border-0 cv-animated-content rounded-4">
          
          <div class="cv-header p-4 p-md-5 bg-white border-bottom">
            <div class="row align-items-center">
              <div class="col-md-3 text-center mb-3 mb-md-0">
                <div class="profile-img-container mx-auto">
                  <%= image_tag "santiago-portrait.JPG", alt: "Matt Santiago", class: "profile-picture" %>
                </div>
              </div>
              <div class="col-md-9 text-center text-md-start">
                <h1 class="display-5 fw-bold mb-1 text-primary">Matt Rayner P. Santiago</h1>
                <p class="lead text-muted mb-3 fw-medium">Backend Developer | Computer Engineering Student</p>
                
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-start text-muted">
                  <a href="mailto:mrsantiago@gbox.adnu.edu.ph" class="text-muted text-decoration-none hover-primary">
                    <i class="bi bi-envelope-fill me-1 text-secondary"></i> mrsantiago@gbox.adnu.edu.ph
                  </a>
                  <a href="https://github.com/MaTT-R4Yn0" class="text-muted text-decoration-none hover-primary">
                    <i class="bi bi-github me-1 text-secondary"></i> GitHub
                  </a>
                  <a href="https://linkedin.com/in/matt-rayner-p-santiago-1b8596296" class="text-muted text-decoration-none hover-primary">
                    <i class="bi bi-linkedin me-1 text-secondary"></i> LinkedIn
                  </a>
                  <span class="text-muted">
                    <i class="bi bi-geo-alt-fill me-1 text-secondary"></i> Naga City, Philippines
                  </span>
                </div>
              </div>
            </div>
          </div>

          <div class="card-body p-4 p-md-5 bg-white">
            
            <section class="mb-5">
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-person-lines-fill fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Professional Summary</h2>
              </div>
              <p class="text-muted">
                Dedicated <strong>Backend Developer</strong> and Computer Engineering student specializing in building robust, scalable web applications using <strong>Ruby on Rails</strong> and <strong>PostgreSQL</strong>. Passionate about bridging hardware-software interfaces and optimizing logic-heavy backend architectures. Currently applying engineering principles to web development to create clean, maintainable code and efficient database structures.
              </p>
            </section>

            <section class="mb-5">
              <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <i class="bi bi-cpu-fill fs-3 text-primary me-2"></i>
                <h2 class="h4 text-secondary mb-0 fw-bold">Technical Skills</h2>
              </div>
              
              <div class="mb-3">
                <small class="text-uppercase text-muted fw-bold ls-1">Core Stack</small>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <span class="badge rounded-pill text-bg-primary py-2 px-3"><i class="bi bi-gem me-1"></i> Ruby on Rails</span>
                  <span class="badge rounded-pill text-bg-primary py-2 px-3"><i class="bi bi-database-fill me-1"></i> SQL / PostgreSQL</span>
                  <span class="badge rounded-pill text-bg-info py-2 px-3 text-white"><i class="bi bi-bootstrap-fill me-1"></i> Bootstrap 5</span>
