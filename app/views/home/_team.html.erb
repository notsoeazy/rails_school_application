                <i class="bi bi-github me-1"></i></a>
              </li>
              <li><a href="cv/santiago" class="popup-link">
                <i class="bi bi-person-badge me-1"></i></a>
              </li>
              <li><a href="#" class="popup-link">
                <i class="bi bi-linkedin me-1"></i></a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- MEMBER 3 -->
      <div class="col-md-4">
        <div class="team-card-wrapper">
          <div class="team-card shadow-sm p-4 text-center slide-up delay-2">

            <div class="team-img-placeholder mb-3">
              <%= image_tag "tipay-portrait.JPG" , alt: "Gian Tipay Picture" %>
            </div>

            <h4 class="fw-semibold mb-1">Gian</h4>
