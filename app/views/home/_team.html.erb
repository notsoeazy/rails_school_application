
<section class="about-hero d-flex align-items-center justify-content-center text-center">
  <div class="container">
    <h1 class="display-5 fw-bold fade-in">Meet Our Team</h1>
    <p class="lead mt-3 fade-in-delay">
      We are a passionate group of developers building modern, user-friendly web applications.
    </p>
  </div>
</section>

<section class="team-section py-5">
  <div class="container">
    <div class="row g-4 mt-3">

      <!-- MEMBER 1 -->
      <div class="col-md-4">
        <div class="team-card-wrapper">
          <div class="team-card shadow-sm p-4 text-center slide-up">

            <div class="team-img-placeholder mb-3">
              <%= image_tag "gonzales-portrait.JPG" , alt: "Ezekiel Gonzales Picture" %>
            </div>

            <h4 class="fw-semibold mb-1">Ezekiel</h4>
            <p class="text-muted">Full-stack Developer</p>
            <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
              <span class="skill-badge">Ruby on Rails</span>
              <span class="skill-badge">Linux</span>
              <span class="skill-badge">Docker</span>
            </div>
          </div>

          <div class="team-popup shadow-lg text-center">
            <h5 class="fw-semibold">John Ezekiel Gonzales</h5>
            <p>Loves full-stack work, optimizations, and system architecture.</p>

            <ul class="list-unstyled mt-2 d-flex justify-content-center gap-4">
              <li><a href="https://github.com/notsoeazy/" class="popup-link">
                <i class="bi bi-github"></i></a>
              </li>
              <li><a href="cv/gonzales" class="popup-link">
                <i class="bi bi-person-badge"></i></a>
              </li>
              <li><a href="#" class="popup-link">
                <i class="bi bi-linkedin"></i></a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- MEMBER 2 -->
      <div class="col-md-4">
